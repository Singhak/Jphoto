# fal.ai API key for background removal and masked scene generation: https://fal.ai/dashboard/keys
FAL_KEY=

# Gemini API key for model shots and the quality judge: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change often; check https://ai.google.dev/gemini-api/docs/models and set them here.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# Cutout: leave empty to use fal when FAL_KEY is set and fall back to the free local model if fal fails.
# "local" or "fal" forces that engine with no fallback (useful when testing one engine).
CUTOUT_ENGINE=

# Postgres. Any provider works: Supabase, Neon, RDS, or your own server (see docker-compose.yml).
# On Supabase, use the "Session pooler" or direct connection string. Then run: npm run db:migrate
DATABASE_URL=postgres://jphoto:jphoto@localhost:5432/jphoto

# Login. Generate a secret with: npx @better-auth/cli secret   (or any random 32+ characters)
BETTER_AUTH_SECRET=
# The site's address. Must match the Google redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Web application): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where photos are stored: "local" (.cache/storage on this machine) or "s3" (any S3-compatible private bucket).
STORAGE_DRIVER=local
# For "s3". Supabase Storage: endpoint https://<project>.supabase.co/storage/v1/s3 with its S3 access keys.
# Cloudflare R2: https://<account>.r2.cloudflarestorage.com, region auto. MinIO: http://localhost:9000.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Free test top-ups are allowed in development. Set to 1 to allow them on a deployed test site too; never in production.
ALLOW_TEST_TOPUP=
