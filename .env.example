# fal.ai API key for background removal and masked scene generation: https://fal.ai/dashboard/keys
FAL_KEY=

# Gemini API key for model shots and the quality judge: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change often; check https://ai.google.dev/gemini-api/docs/models and set them here.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# Cutout: leave empty to use fal when FAL_KEY is set and fall back to the free local model if fal fails.
# "local" or "fal" forces that engine with no fallback (useful when testing one engine).
CUTOUT_ENGINE=

# Postgres. Any provider works: Supabase, Neon, RDS, or your own server (see docker-compose.yml).
# On Supabase, use the "Session pooler" or direct connection string. Then run: npm run db:migrate
DATABASE_URL=postgres://jphoto:jphoto@localhost:5432/jphoto
# A separate database for `npm test`, which wipes it. Make it once: createdb jphoto_test (or CREATE DATABASE in psql).
TEST_DATABASE_URL=postgres://jphoto:jphoto@localhost:5432/jphoto_test

# Login. Generate a secret with: npx @better-auth/cli secret   (or any random 32+ characters)
BETTER_AUTH_SECRET=
# The site's address. Must match the Google redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Web application): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where photos are stored: "local" (.cache/storage on this machine) or "s3" (any S3-compatible private bucket).
STORAGE_DRIVER=local
# For "s3". Supabase Storage: endpoint https://<project>.supabase.co/storage/v1/s3 with its S3 access keys.
# Cloudflare R2: https://<account>.r2.cloudflarestorage.com, region auto. MinIO: http://localhost:9000.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Free test top-ups are allowed in development. Set to 1 to allow them on a deployed test site too; never in production.
ALLOW_TEST_TOPUP=

# Payments: Cashfree Payment Gateway (https://merchant.cashfree.com > Developers > API keys).
# Leave empty and top-ups add free test credits (development only).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "sandbox" for test payments, "production" for real money.
CASHFREE_ENV=sandbox

# Model looks (bride, groom, everyday, men's, kids') stay hidden until exact mode is built. Set to 1 to show them.
# This is read when the app is built, so rebuild after changing it.
NEXT_PUBLIC_MODEL_LOOKS=

# Daily limits per account (lib/limits.ts). Each photo check and preview costs an AI call even if nothing is downloaded.
LIMIT_CHECKS_PER_DAY=100
LIMIT_PREVIEWS_PER_DAY=60
LIMIT_TRIES_PER_LOOK=3
LIMIT_PDFS_PER_DAY=50
LIMIT_ZIPS_PER_DAY=50
LIMIT_ORDERS_PER_DAY=20

# Prices for `npm run spend`, in US dollars per call, from your fal and Google billing pages.
# fal fill is priced exactly from the megapixels sent; these are the other paid calls. Empty leaves them out of the totals.
SPEND_FAL_CUTOUT_USD=
SPEND_GEMINI_IMAGE_USD=
SPEND_GEMINI_CHECK_USD=

# Error monitoring (Sentry, https://sentry.io > Project settings > Client keys). Empty turns it off.
# One DSN for both server and browser. It is read when the app is built, so rebuild after changing it.
NEXT_PUBLIC_SENTRY_DSN=
# Optional label for this site in Sentry, e.g. "staging". Defaults to development/production.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional, at build time only: uploads source maps so Sentry shows our code instead of minified bundles.
# Auth token: Sentry > Settings > Auth Tokens (scope project:releases). Org and project are their URL slugs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
