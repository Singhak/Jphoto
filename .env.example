# fal.ai API key for background removal and masked scene generation: https://fal.ai/dashboard/keys
FAL_KEY=

# Gemini API key for model shots and the quality judge: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change often; check https://ai.google.dev/gemini-api/docs/models and set them here.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# Cutout: "local" (free, on this machine) or "fal". Defaults to fal when FAL_KEY is set.
CUTOUT_ENGINE=
